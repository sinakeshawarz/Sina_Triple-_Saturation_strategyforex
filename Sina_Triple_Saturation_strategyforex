logging.getLogger("yfinance").setLevel(logging.CRITICAL)

# ========================== CONFIG ==========================
TICKERS = {"XAUUSD": "GC=F"}
CONFIG = {
    "initial_capital": 22000,
    "min_trades": 50,
    "max_dd_cap": -18.0,
    "min_pf": 1.20,
    "min_rr": 1.18,
    "n_trials": 4000,
}

FOCUS_INTERVALS = ["8m", "10m", "12m", "15m", "30m"]

INTERVAL_SPEC = {
    "8m":  ("5m",  "8min",  60),
    "10m": ("5m",  "10min", 60),
    "12m": ("5m",  "12min", 60),
    "15m": ("15m", None,    60),
    "30m": ("15m", "30min", 60),
}

# ========================== DATA ==========================
def download_ohlcv(sym, interval):
    native, rule, max_days = INTERVAL_SPEC[interval]
    start = datetime.utcnow() - timedelta(days=max_days)
    df = yf.download(sym, start=start, interval=native,
                     progress=False, auto_adjust=True, threads=False)
    if df.empty or len(df) < 30:
        raise ValueError("No data")
    if isinstance(df.columns, pd.MultiIndex):
        df.columns = df.columns.get_level_values(0)
    df = df[["Open","High","Low","Close","Volume"]].copy()
    df.columns = ["open","high","low","close","volume"]
    df.index = pd.to_datetime(df.index).tz_localize(None)
    if rule:
        df = df.resample(rule).agg({"open":"first","high":"max","low":"min",
                                    "close":"last","volume":"sum"}).dropna()
    return df

# ========================== INDICATORS ==========================
def rsi(s, n):
    d = s.diff()
    g = d.clip(lower=0).ewm(alpha=1/n, adjust=False).mean()
    l = (-d.clip(upper=0)).ewm(alpha=1/n, adjust=False).mean()
    return 100 - 100 / (1 + g / l.replace(0, np.nan))

def wma(s, n):
    w = np.arange(1, n+1)
    return s.rolling(n).apply(lambda x: np.dot(x, w)/w.sum(), raw=True)

def ema(s, n): return s.ewm(span=n, adjust=False).mean()

def atr(df, n):
    tr = pd.concat([df.high-df.low, (df.high-df.close.shift()).abs(),
                    (df.low-df.close.shift()).abs()], axis=1).max(axis=1)
    return tr.ewm(span=n, adjust=False).mean()

def adx(df, n):
    up, dn = df.high.diff(), -df.low.diff()
    plus = np.where((up > dn) & (up > 0), up, 0)
    minus = np.where((dn > up) & (dn > 0), dn, 0)
    tr = atr(df, n)
    pdi = 100 * ema(pd.Series(plus, index=df.index), n) / tr
    mdi = 100 * ema(pd.Series(minus, index=df.index), n) / tr
    dx = 100 * (pdi - mdi).abs() / (pdi + mdi).replace(0, np.nan)
    return ema(dx, n)

# ========================== PARAMS ==========================
def base_params():
    return {
        "rsiLen": 5, "wmaLen": 8, "iftBuyThr": -0.36, "iftSellThr": 0.36,
        "adxLen": 8, "adxMax": 30, "zLen": 40, "zSmooth": 8,
        "fLong": 18, "fShort": 9, "tsiBuyThr": -16, "tsiSellThr": 16,
        "zBuyQ": 0.22, "zSellQ": 0.78,
    }

GRID = {
    "iftBuyThr": [-0.32, -0.38, -0.44],
    "iftSellThr": [0.32, 0.38, 0.44],
    "zBuyQ": [0.18, 0.24, 0.30],
    "zSellQ": [0.70, 0.76, 0.82],
    "tsiBuyThr": [-12, -16, -20],
    "tsiSellThr": [12, 16, 20],
    "adxMax": [26, 30, 34],
    "sl_mult": [0.7, 0.9, 1.1],
    "tp_mult": [1.6, 2.2, 2.8, 3.2],
    "be_R": [0.0, 1.0],
    "trail_R": [0.0, 1.5],
    "trail_mult": [0.8, 1.0],
    "time_stop": [0, 40],
    "risk_pct": [0.005, 0.007, 0.009],
}

def sample_params(rng):
    p = base_params()
    for k, vals in GRID.items():
        if k in ["sl_mult", "tp_mult", "be_R", "trail_R", "trail_mult", "time_stop", "risk_pct"]:
            continue
        p[k] = rng.choice(vals)
    return p

# ========================== SIGNALS ==========================
def compute_signals(df, p):
    c = df.close
    ift_raw = 0.1 * (rsi(c, p["rsiLen"]) - 50)
    ift = (np.exp(2 * wma(ift_raw, p["wmaLen"])) - 1) / (np.exp(2 * wma(ift_raw, p["wmaLen"])) + 1)
    z = ((c - c.rolling(p["zLen"]).mean()) / c.rolling(p["zLen"]).std()).rolling(p["zSmooth"]).mean()
    tsi = 100 * ema(ema(c.diff(), p["fLong"]), p["fShort"]) / \
          ema(ema(c.diff().abs(), p["fLong"]), p["fShort"]).replace(0, np.nan)
    adx_val = adx(df, p["adxLen"])
    htf_bull = ema(c, p["fLong"]*2) > ema(c, p["fLong"]*4)
    htf_bear = ema(c, p["fLong"]*2) < ema(c, p["fLong"]*4)

    z_ext_buy  = z <= z.rolling(30).quantile(0.20)
    z_ext_sell = z >= z.rolling(30).quantile(0.80)

    buy_score = (
        (ift <= p["iftBuyThr"] - 0.04).astype(int) +
        z_ext_buy.astype(int) +
        (tsi < p["tsiBuyThr"] - 4).astype(int) +
        (adx_val < p["adxMax"] - 4).astype(int)
    )
    sell_score = (
        (ift >= p["iftSellThr"] + 0.04).astype(int) +
        z_ext_sell.astype(int) +
        (tsi > p["tsiSellThr"] + 4).astype(int) +
        (adx_val < p["adxMax"] - 4).astype(int)
    )

    buy = (buy_score >= 3) & htf_bull & (c > c.shift(1))
    sell = (sell_score >= 3) & htf_bear & (c < c.shift(1))
    buy = buy & ~buy.shift(1).fillna(False)
    sell = sell & ~sell.shift(1).fillna(False)

    out = df.copy()
    out["buy"] = buy.fillna(False)
    out["sell"] = sell.fillna(False)
    out["atr14"] = atr(df, 14)
    return out

# ========================== BACKTEST ==========================
def run_backtest(df, sl_m, tp_m, capital=22000, risk_pct=0.007,
                 be_R=1.0, trail_R=1.5, trail_mult=1.0, time_stop=0):
    close = df.close.values
    buy, sell = df.buy.values, df.sell.values
    atrv = df.atr14.values
    eq = np.full(len(df), float(capital))
    pnls = []
    pos = entry = entry_i = 0
    stop = risk = 0.0

    for i in range(1, len(df)):
        price = close[i]
        a = atrv[i] if atrv[i] > 0 else price * 0.01
        if pos == 0:
            if buy[i]:
                pos, entry, entry_i = 1, price, i
                stop, risk = entry - sl_m * a, sl_m * a
            elif sell[i]:
                pos, entry, entry_i = -1, price, i
                stop, risk = entry + sl_m * a, sl_m * a
            eq[i] = eq[i-1]
            continue

        R = (price - entry) / risk * pos if risk > 0 else 0
        if pos == 1:
            if be_R > 0 and R >= be_R: stop = max(stop, entry)
            if trail_R > 0 and R >= trail_R: stop = max(stop, price - trail_mult * a)
            hit = price <= stop or price >= entry + tp_m * a or sell[i] or (time_stop > 0 and i-entry_i >= time_stop)
        else:
            if be_R > 0 and R >= be_R: stop = min(stop, entry)
            if trail_R > 0 and R >= trail_R: stop = min(stop, price + trail_mult * a)
            hit = price >= stop or price <= entry - tp_m * a or buy[i] or (time_stop > 0 and i-entry_i >= time_stop)

        if hit:
            size = (eq[i-1] * risk_pct) / risk if risk > 0 else 0
            pnl = (price - entry) * pos * size
            eq[i] = eq[i-1] + pnl
            pnls.append(pnl)
            pos = 0
        else:
            eq[i] = eq[i-1]

    ret = (eq[-1]/capital - 1)*100
    if pnls:
        wins = [x for x in pnls if x > 0]
        losses = [x for x in pnls if x < 0]
        pf = sum(wins)/abs(sum(losses)) if losses else 99
        wr = len(wins)/len(pnls)*100
        aw = np.mean(wins) if wins else 0
        al = np.mean(losses) if losses else 0
    else:
        pf = wr = aw = al = 0
    max_dd = np.min((eq - np.maximum.accumulate(eq))/np.maximum.accumulate(eq))*100
    return {"return": ret, "pf": pf, "wr": wr, "max_dd": max_dd,
            "trades": len(pnls), "avg_win": aw, "avg_loss": al,
            "equity": pd.Series(eq, index=df.index)}

# ========================== SCORING ==========================
def score(m):
    if m["trades"] < CONFIG["min_trades"]: return -1e9
    if m["pf"] < CONFIG["min_pf"]: return -1e9
    if m["max_dd"] < CONFIG["max_dd_cap"]: return -1e9
    rr = m["avg_win"] / max(abs(m["avg_loss"]), 1e-6)
    if rr < CONFIG["min_rr"]: return -1e9
    calmar = m["return"] / max(abs(m["max_dd"]), 1.0)
    base = m["return"]*2.0 + m["pf"]*10 + calmar*2.5 - abs(m["max_dd"])*0.7
    return base * min(np.sqrt(m["trades"])/7.0, 1.0)

# ========================== LOAD & OPTIMIZE ==========================
print("Loading focused intervals...")
data = {}
for iv in FOCUS_INTERVALS:
    data[iv] = download_ohlcv(TICKERS["XAUUSD"], iv)
    print(f"  {iv}: {len(data[iv])} bars")

rng = random.Random(42)
results = []

print(f"\nRunning {CONFIG['n_trials']} trials on {FOCUS_INTERVALS}...\n")
for _ in range(CONFIG["n_trials"]):
    iv = rng.choice(FOCUS_INTERVALS)
    params = sample_params(rng)
    sl = rng.choice(GRID["sl_mult"])
    tp = rng.choice(GRID["tp_mult"])
    be = rng.choice(GRID["be_R"])
    tr = rng.choice(GRID["trail_R"])
    tm = rng.choice(GRID["trail_mult"])
    ts = rng.choice(GRID["time_stop"])
    rp = rng.choice(GRID["risk_pct"])
    try:
        sig = compute_signals(data[iv], params)
        m = run_backtest(sig, sl, tp, CONFIG["initial_capital"], rp, be, tr, tm, ts)
        sc = score(m)
        if sc > -1e8:
            results.append({"interval": iv, "params": params, "sl": sl, "tp": tp,
                            "be": be, "trail": tr, "trail_m": tm, "time": ts,
                            "risk": rp, "score": sc, **m})
    except:
        continue

results.sort(key=lambda x: x["score"], reverse=True)

print("=== TOP 10 ===")
for i, r in enumerate(results[:10], 1):
    print(f"{i}. {r['interval']:5} Ret {r['return']:+6.1f}%  PF {r['pf']:.2f}  "
          f"DD {r['max_dd']:.1f}%  Trades {r['trades']}")

if results:
    best = results[0]
    print("\nBEST CONFIG")
    print(f"Interval : {best['interval']}")
    print(f"SL / TP  : {best['sl']} / {best['tp']}")
    print(f"Risk     : {best['risk']*100:.2f}%")
    print(f"Return   : {best['return']:+.1f}%")
    print(f"PF       : {best['pf']:.2f}")
    print(f"Max DD   : {best['max_dd']:.1f}%")
    print(f"Trades   : {best['trades']}")

    # Plot
    sig = compute_signals(data[best["interval"]], best["params"])
    full = run_backtest(sig, best["sl"], best["tp"], CONFIG["initial_capital"],
                        best["risk"], best["be"], best["trail"], best["trail_m"], best["time"])
    fig, ax = plt.subplots(2, 1, figsize=(13, 7), sharex=True)
    ax[0].plot(sig.index, sig.close, color="black", lw=0.8)
    ax[0].scatter(sig.index[sig.buy], sig.close[sig.buy], marker="^", color="lime", s=25)
    ax[0].scatter(sig.index[sig.sell], sig.close[sig.sell], marker="v", color="red", s=25)
    ax[0].set_title(f"Best: {best['interval']}  Return {best['return']:+.1f}%")
    ax[1].plot(full["equity"].index, full["equity"], color="blue")
    ax[1].set_title("Equity")
    plt.tight_layout()
    plt.show()

print("\nDone.")
